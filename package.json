{
  "name": "nozilla-whiteboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Lokales Werkzeug für Markdown-Präsentationen und freie Flächen — streng nach der nozilla Corporate Identity.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "sync:ci": "node scripts/sync-ci.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"*.ts\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"*.ts\" \"scripts/*.mjs\""
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "js-yaml": "^4.1.0",
    "jspdf": "^2.5.2",
    "marked": "^15.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.1",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
