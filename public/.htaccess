# ===========================================================================
# board.nozilla.net — Apache-Konfiguration für das gebaute Whiteboard
#
# Diese Datei liegt in `public/` und wird von Vite unverändert nach `dist/`
# kopiert. Sie landet damit im Dokumentenstamm, ohne dass jemand sie von Hand
# auf den Server legen muss.
#
# Die App ist reines Vorderende: kein Server, keine Datenbank, keine Sitzung.
# Apache muss deshalb nur drei Dinge richtig machen — ausliefern, komprimieren
# und den Zwischenspeicher richtig einstellen.
# ===========================================================================

# --- Zeichensatz -----------------------------------------------------------
AddDefaultCharset UTF-8

# --- MIME-Typen ------------------------------------------------------------
# Manche Webhosting-Apachen kennen WOFF2 nicht. Ohne den richtigen Typ lädt der
# Browser die Schrift zwar, verwirft sie aber, und der Setzer misst gegen die
# Ersatzschrift — genau der Fehler, der die Wortabstände zerlegt.
AddType font/woff2 .woff2
AddType font/ttf   .ttf
AddType image/svg+xml .svg

# --- Kompression -----------------------------------------------------------
# WOFF2 ist bereits mit Brotli gepackt und PNG ebenfalls; beide noch einmal zu
# komprimieren kostet Rechenzeit und bringt nichts.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Zwischenspeicher ------------------------------------------------------
<IfModule mod_headers.c>
  # Die Bündel unter /assets/ tragen einen Inhalts-Hash im Dateinamen. Ändert
  # sich der Inhalt, ändert sich der Name — sie dürfen deshalb ewig liegen.
  <FilesMatch "\.(js|css|map)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Schriften und Marken-Grafiken behalten ihren Namen über Bereitstellungen
  # hinweg. Sie ändern sich selten, aber sie *können* sich ändern — ein Jahr
  # wäre gelogen, eine Woche ist ehrlich.
  <FilesMatch "\.(woff2|ttf|png|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # `index.html` nennt die Bündelnamen. Wird sie zwischengespeichert, holt der
  # Browser nach einer Bereitstellung die alten Namen und bekommt 404.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # --- Kopfzeilen ----------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Bewusst keine Content-Security-Policy. Die Ausgabe baut Blobs und
  # data-URLs (PDF, PPTX, SVG, Bilder), und eine Richtlinie, die das nicht
  # kennt, bricht den Export still. Wer sie setzen will, prüft vorher jeden
  # Ausgabeweg im Browser.
</IfModule>

# --- Verzeichnisse ---------------------------------------------------------
Options -Indexes

# Bewusst *keine* Umleitung auf index.html. Die App hat keine Adressen unter
# sich; ein Pfad, den es nicht gibt, ist ein Fehler und soll einer bleiben.
